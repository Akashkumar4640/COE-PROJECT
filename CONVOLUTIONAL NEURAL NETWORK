import torch
import torch.nn as nn
class DogCatCNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.conv1 = nn.Sequential(
            nn.Conv2d(in_channels=3, out_channels=32, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2, stride=2)
        )
        self.conv2 = nn.Sequential(
            nn.Conv2d(in_channels=32, out_channels=64, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2, stride=2)
        )
        self.conv3 = nn.Sequential(
            nn.Conv2d(in_channels=64, out_channels=128, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(kernel_size=2, stride=2)
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(128 * 8 * 8, 128),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(128, 1)
        )

    def forward(self, x):
        x = self.conv1(x)
        x = self.conv2(x)
        x = self.conv3(x)
        return self.classifier(x)
model = DogCatCNN()
criterion = nn.BCEWithLogitsLoss()
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
dummy_images = torch.randn(8, 3, 64, 64)
dummy_labels = torch.tensor([[0.], [1.], [1.], [0.], [1.], [0.], [0.], [1.]])
model.train()
optimizer.zero_grad()
outputs = model(dummy_images)
loss = criterion(outputs, dummy_labels)
loss.backward()
optimizer.step()

print(f"Sample Step Loss: {loss.item():.4f}")
print("Predicted probabilities:", torch.sigmoid(outputs).detach().flatten().tolist())